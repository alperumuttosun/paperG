# ---- 7. Log-loss ve NESTED-TUNING yardimci fonksiyon ----
logloss <- function(y_true, p) {
  p <- pmin(pmax(p, 1e-6), 1 - 1e-6)
  -mean(y_true * log(p) + (1 - y_true) * log(1 - p))
}

domain_reduced_cols <- lapply(domains, function(cols) setdiff(all_feats, cols))

# lambda artik SABITLENMIYOR. Her cagride, verilen egitim setinin
# (tr_idx) KENDI ICINDE 5-fold ic-CV ile lambda secilir (cv.glmnet),
# sonra o egitim setiyle fit edilip test setinde degerlendirilir.
# Boylece test seti (te_idx) lambda secimine hicbir sekilde karismaz.
fit_predict_logloss_glmnet_nested <- function(cols, tr_idx, te_idx, inner_folds = 5) {
  Xtr <- X[tr_idx, cols, drop = FALSE]
  ytr <- y[tr_idx]
  ctr <- colMeans(Xtr); scl <- apply(Xtr, 2, sd); scl[scl == 0] <- 1
  Xtr_s <- scale(Xtr, center = ctr, scale = scl)
  Xte_s <- scale(X[te_idx, cols, drop = FALSE], center = ctr, scale = scl)

  cvfit <- cv.glmnet(Xtr_s, ytr, family = "binomial", alpha = 0, nfolds = inner_folds)
  fit <- glmnet(Xtr_s, ytr, family = "binomial", alpha = 0, lambda = cvfit$lambda.min)

  p <- as.numeric(predict(fit, newx = Xte_s, type = "response"))
  logloss(y[te_idx], p)
}

# ---- 8. Repeated stratified 5-fold CV (nested tuning ile nokta tahmini) ----
create_stratified_folds <- function(y, k) {
  idx0 <- which(y == 0); idx1 <- which(y == 1)
  f0 <- split(sample(idx0), rep(1:k, length.out = length(idx0)))
  f1 <- split(sample(idx1), rep(1:k, length.out = length(idx1)))
  lapply(1:k, function(i) c(f0[[i]], f1[[i]]))
}

n_repeats <- 20; n_folds <- 5
test_splits <- list()
set.seed(42)
for (r in seq_len(n_repeats)) test_splits <- c(test_splits, create_stratified_folds(y, n_folds))
cat("Toplam test-fold sayisi:", length(test_splits), "\n")

cv_logloss_glmnet_nested <- function(cols) {
  sapply(test_splits, function(te_idx) {
    tr_idx <- setdiff(seq_len(n), te_idx)
    fit_predict_logloss_glmnet_nested(cols, tr_idx, te_idx)
  })
}

t0 <- Sys.time()
