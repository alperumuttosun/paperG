    logloss(y[te_idx], predict(fit, dte))                            # test log-loss
  }
  B_xgb <- 200                                                       # number of bootstrap replicates
  boot_uj_xgb <- setNames(lapply(domains, function(x) numeric(B_xgb)), names(domains))  # storage
  set.seed(7)                                                        # bootstrap seed
  for (b in seq_len(B_xgb)) {
    boot_idx <- sample(seq_len(n), n, replace = TRUE)                # bootstrap training sample
    oob_idx  <- setdiff(seq_len(n), unique(boot_idx))                # out-of-bag test patients
    if (length(oob_idx) < 15) next                                   # skip if OOB set is too small
    full_ll <- fit_predict_logloss_xgb(all_feats, boot_idx, oob_idx) # full-model OOB loss
    for (d in names(domains)) {
      boot_uj_xgb[[d]][b] <- fit_predict_logloss_xgb(domain_reduced_cols[[d]], boot_idx, oob_idx) - full_ll  # U_j
    }
  }
  xgb_boot_summary <- do.call(rbind, lapply(names(domains), function(d) {
    v <- boot_uj_xgb[[d]]                                            # bootstrap U_j values
    data.frame(domain = d, mean = mean(v), lo95 = quantile(v, .025), hi95 = quantile(v, .975), p_positive = mean(v > 0))
  }))
  write.csv(xgb_boot_summary, "xgb_bootstrap_Uj.csv", row.names = FALSE)  # save

  # ---- 11. Coefficient-based importance ----
  Xs_full <- scale(X)                                                # standardize all features
  cv_full <- cv.glmnet(Xs_full, y, family = "binomial", alpha = 0, nfolds = 5)  # choose ridge lambda
  fit_full <- glmnet(Xs_full, y, family = "binomial", alpha = 0, lambda = cv_full$lambda.min)  # full ridge fit
  coefs <- as.numeric(coef(fit_full))[-1]; names(coefs) <- all_feats # coefficients without intercept
  domain_importance <- sapply(domains, function(cols) sum(abs(coefs[cols])))  # sum of |coef| per domain
  importance_vs_uj <- data.frame(
    domain = names(domains), importance = domain_importance,
    ridge_Uj = sapply(names(domains), function(d) mean(boot_uj_ridge[[d]])),
    xgb_Uj   = sapply(names(domains), function(d) mean(boot_uj_xgb[[d]])))
  write.csv(importance_vs_uj, "importance_vs_Uj.csv", row.names = FALSE)  # save
} else {
