# ---- 5. VIF (fast) ----
vif_manual <- function(Xs) {                                         # compute VIF for each variable
  p <- ncol(Xs)                                                      # number of variables
  vifs <- numeric(p)                                                 # storage for VIFs
  for (j in seq_len(p)) {                                            # loop over variables
    fit <- lm(Xs[, j] ~ Xs[, -j])                                    # regress variable j on all others
    vifs[j] <- 1 / (1 - summary(fit)$r.squared)                      # VIF = 1 / (1 - R^2)
  }
  names(vifs) <- colnames(Xs)                                        # name the VIFs
  sort(vifs, decreasing = TRUE)                                      # largest first
}
vif_vals <- vif_manual(scale(X))                                     # VIF on standardized features
write.csv(data.frame(variable = names(vif_vals), VIF = vif_vals), "vif_table.csv", row.names = FALSE)  # save
cat("\nTop VIF values:\n"); print(head(vif_vals, 10))                # show the 10 largest

# ---- 6. Within-domain effective dimensionality (fast) ----
effective_dim <- function(cols) {                                    # PCs needed for 95% of variance
  if (length(cols) == 1) return(1L)                                  # single variable -> 1 dimension
  pc <- prcomp(scale(X[, cols]))                                     # PCA on the domain variables
  cum_var <- cumsum(pc$sdev^2) / sum(pc$sdev^2)                      # cumulative variance explained
  which(cum_var >= 0.95)[1]                                          # first PC count reaching 95%
}
