cat(sprintf("Full model ortalama log-loss (repeated CV, nested tuning): %.4f  (sure: %.1f sn)\n",
            mean(full_losses), as.numeric(difftime(Sys.time(), t0, units = "secs"))))

Uj_cv <- list()
t0 <- Sys.time()
for (d in names(domains)) {
  red_losses <- cv_logloss_glmnet_nested(domain_reduced_cols[[d]])
  Uj_cv[[d]] <- red_losses - full_losses
  cat(sprintf("%-18s Uj(mean)=%.4f  Uj(sd)=%.4f\n", d, mean(Uj_cv[[d]]), sd(Uj_cv[[d]])))
}
cat(sprintf("Repeated-CV toplam sure (10 domain): %.1f sn\n", as.numeric(difftime(Sys.time(), t0, units = "secs"))))

# ---- 9. Hasta-duzeyi bootstrap (Ridge, NESTED tuning) ----
B <- 500
boot_uj_ridge <- setNames(lapply(domains, function(x) numeric(B)), names(domains))

set.seed(123)
t0 <- Sys.time()
for (b in seq_len(B)) {
  boot_idx <- sample(seq_len(n), n, replace = TRUE)
  oob_idx  <- setdiff(seq_len(n), unique(boot_idx))
  if (length(oob_idx) < 15) next

  full_ll <- fit_predict_logloss_glmnet_nested(all_feats, boot_idx, oob_idx)
  for (d in names(domains)) {
    red_ll <- fit_predict_logloss_glmnet_nested(domain_reduced_cols[[d]], boot_idx, oob_idx)
    boot_uj_ridge[[d]][b] <- red_ll - full_ll
  }
  if (b %% 50 == 0) cat(b, "/", B, "-", round(difftime(Sys.time(), t0, units = "secs"), 1), "sn\n")
}
cat("Ridge bootstrap toplam suresi:", round(difftime(Sys.time(), t0, units = "secs"), 1), "sn\n")

ridge_boot_summary <- do.call(rbind, lapply(names(domains), function(d) {
  v <- boot_uj_ridge[[d]]
  data.frame(domain = d, mean = mean(v), lo95 = quantile(v, .025), hi95 = quantile(v, .975),
             p_positive = mean(v > 0))
}))
