# ---- 10. XGBoost sensitivity ----
xgb_params <- list(objective = "binary:logistic", max_depth = 2, eta = 0.08,
                    subsample = 0.8, colsample_bytree = 0.8, lambda = 2,
                    eval_metric = "logloss")
xgb_nrounds <- 150

fit_predict_logloss_xgb <- function(cols, tr_idx, te_idx) {
  dtr <- xgb.DMatrix(data = X[tr_idx, cols, drop = FALSE], label = y[tr_idx])
  dte <- xgb.DMatrix(data = X[te_idx, cols, drop = FALSE], label = y[te_idx])
  fit <- xgb.train(params = xgb_params, data = dtr, nrounds = xgb_nrounds, verbose = 0)
  logloss(y[te_idx], predict(fit, dte))
}

B_xgb <- 200
boot_uj_xgb <- setNames(lapply(domains, function(x) numeric(B_xgb)), names(domains))

set.seed(7)
t0 <- Sys.time()
for (b in seq_len(B_xgb)) {
  boot_idx <- sample(seq_len(n), n, replace = TRUE)
  oob_idx  <- setdiff(seq_len(n), unique(boot_idx))
  if (length(oob_idx) < 15) next

  full_ll <- fit_predict_logloss_xgb(all_feats, boot_idx, oob_idx)
  for (d in names(domains)) {
    red_ll <- fit_predict_logloss_xgb(domain_reduced_cols[[d]], boot_idx, oob_idx)
    boot_uj_xgb[[d]][b] <- red_ll - full_ll
