# ---- 7. Log-loss and helper objects ----
logloss <- function(y_true, p) {                                     # binary log-loss
  p <- pmin(pmax(p, 1e-6), 1 - 1e-6)                                 # clip probabilities away from 0 and 1
  -mean(y_true * log(p) + (1 - y_true) * log(1 - p))                 # mean negative log-likelihood
}

domain_reduced_cols <- lapply(domains, function(cols) setdiff(all_feats, cols))  # features with one domain removed

# ================== 8-11. OLD HEAVY ANALYSES ==================
if (RUN_OLD_HEAVY) {
  # ---- 7b. Nested ridge ----
  fit_predict_logloss_glmnet_nested <- function(cols, tr_idx, te_idx, inner_folds = 5) {
    Xtr <- X[tr_idx, cols, drop = FALSE]                             # training features
    ytr <- y[tr_idx]                                                 # training outcome
    ctr <- colMeans(Xtr); scl <- apply(Xtr, 2, sd); scl[scl == 0] <- 1  # training means and SDs
    Xtr_s <- scale(Xtr, center = ctr, scale = scl)                   # standardize training data
    Xte_s <- scale(X[te_idx, cols, drop = FALSE], center = ctr, scale = scl)  # standardize test data with training stats
    cvfit <- cv.glmnet(Xtr_s, ytr, family = "binomial", alpha = 0, nfolds = inner_folds)  # inner CV picks lambda
    fit <- glmnet(Xtr_s, ytr, family = "binomial", alpha = 0, lambda = cvfit$lambda.min)  # final ridge fit
    p <- as.numeric(predict(fit, newx = Xte_s, type = "response"))   # predicted probabilities
    logloss(y[te_idx], p)                                            # test log-loss
  }

  # ---- 8. Repeated stratified 5-fold CV ----
  create_stratified_folds <- function(y, k) {                        # stratified k-fold test indices
    idx0 <- which(y == 0); idx1 <- which(y == 1)                     # indices of each class
    f0 <- split(sample(idx0), rep(1:k, length.out = length(idx0)))   # shuffle and split class 0
    f1 <- split(sample(idx1), rep(1:k, length.out = length(idx1)))   # shuffle and split class 1
    lapply(1:k, function(i) c(f0[[i]], f1[[i]]))                     # combine per fold
  }
  n_repeats <- 20; n_folds <- 5                                      # 20 repeats x 5 folds
  test_splits <- list()                                              # storage for all test folds
  set.seed(42)                                                       # seed for the CV splits
  for (r in seq_len(n_repeats)) test_splits <- c(test_splits, create_stratified_folds(y, n_folds))  # build all splits
  cv_logloss_glmnet_nested <- function(cols) {                       # CV log-loss over all splits
    sapply(test_splits, function(te_idx) {
      tr_idx <- setdiff(seq_len(n), te_idx)                          # training indices
      fit_predict_logloss_glmnet_nested(cols, tr_idx, te_idx)        # test log-loss for this split
    })
  }
  full_losses <- cv_logloss_glmnet_nested(all_feats)                 # full-model losses
  Uj_cv <- list()                                                    # storage for domain contributions
  for (d in names(domains)) {                                        # loop over domains
    Uj_cv[[d]] <- cv_logloss_glmnet_nested(domain_reduced_cols[[d]]) - full_losses  # U_j = reduced - full
    cat(sprintf("%-18s Uj(mean)=%.4f\n", d, mean(Uj_cv[[d]])))       # print the mean
  }

  # ---- 9. Ridge bootstrap (B = 500) ----
  B <- 500                                                           # number of bootstrap replicates
  boot_uj_ridge <- setNames(lapply(domains, function(x) numeric(B)), names(domains))  # storage
  set.seed(123)                                                      # bootstrap seed
  for (b in seq_len(B)) {
    boot_idx <- sample(seq_len(n), n, replace = TRUE)                # bootstrap training sample
    oob_idx  <- setdiff(seq_len(n), unique(boot_idx))                # out-of-bag test patients
    if (length(oob_idx) < 15) next                                   # skip if OOB set is too small
    full_ll <- fit_predict_logloss_glmnet_nested(all_feats, boot_idx, oob_idx)  # full-model OOB loss
    for (d in names(domains)) {
      boot_uj_ridge[[d]][b] <- fit_predict_logloss_glmnet_nested(domain_reduced_cols[[d]], boot_idx, oob_idx) - full_ll  # U_j
    }
  }
  ridge_boot_summary <- do.call(rbind, lapply(names(domains), function(d) {
    v <- boot_uj_ridge[[d]]                                          # bootstrap U_j values
    data.frame(domain = d, mean = mean(v), lo95 = quantile(v, .025), hi95 = quantile(v, .975), p_positive = mean(v > 0))
  }))
  write.csv(ridge_boot_summary, "ridge_bootstrap_Uj.csv", row.names = FALSE)  # save

  # ---- 10. XGBoost (fixed hyperparameters, B = 200) ----
  xgb_params <- list(objective = "binary:logistic", max_depth = 2, eta = 0.08,
                     subsample = 0.8, colsample_bytree = 0.8, lambda = 2, eval_metric = "logloss")  # fixed settings
  xgb_nrounds <- 150                                                 # number of boosting rounds
  fit_predict_logloss_xgb <- function(cols, tr_idx, te_idx) {
    dtr <- xgb.DMatrix(data = X[tr_idx, cols, drop = FALSE], label = y[tr_idx])  # training matrix
    dte <- xgb.DMatrix(data = X[te_idx, cols, drop = FALSE], label = y[te_idx])  # test matrix
    fit <- xgb.train(params = xgb_params, data = dtr, nrounds = xgb_nrounds, verbose = 0)  # fit XGBoost
    logloss(y[te_idx], predict(fit, dte))                            # test log-loss
  }
  B_xgb <- 200                                                       # number of bootstrap replicates
  boot_uj_xgb <- setNames(lapply(domains, function(x) numeric(B_xgb)), names(domains))  # storage
  set.seed(7)                                                        # bootstrap seed
  for (b in seq_len(B_xgb)) {
    boot_idx <- sample(seq_len(n), n, replace = TRUE)                # bootstrap training sample
    oob_idx  <- setdiff(seq_len(n), unique(boot_idx))                # out-of-bag test patients
    if (length(oob_idx) < 15) next                                   # skip if OOB set is too small
    full_ll <- fit_predict_logloss_xgb(all_feats, boot_idx, oob_idx) # full-model OOB loss
    for (d in names(domains)) {
      boot_uj_xgb[[d]][b] <- fit_predict_logloss_xgb(domain_reduced_cols[[d]], boot_idx, oob_idx) - full_ll  # U_j
    }
  }
  xgb_boot_summary <- do.call(rbind, lapply(names(domains), function(d) {
    v <- boot_uj_xgb[[d]]                                            # bootstrap U_j values
    data.frame(domain = d, mean = mean(v), lo95 = quantile(v, .025), hi95 = quantile(v, .975), p_positive = mean(v > 0))
  }))
  write.csv(xgb_boot_summary, "xgb_bootstrap_Uj.csv", row.names = FALSE)  # save

  # ---- 11. Coefficient-based importance ----
  Xs_full <- scale(X)                                                # standardize all features
  cv_full <- cv.glmnet(Xs_full, y, family = "binomial", alpha = 0, nfolds = 5)  # choose ridge lambda
  fit_full <- glmnet(Xs_full, y, family = "binomial", alpha = 0, lambda = cv_full$lambda.min)  # full ridge fit
  coefs <- as.numeric(coef(fit_full))[-1]; names(coefs) <- all_feats # coefficients without intercept
  domain_importance <- sapply(domains, function(cols) sum(abs(coefs[cols])))  # sum of |coef| per domain
  importance_vs_uj <- data.frame(
    domain = names(domains), importance = domain_importance,
    ridge_Uj = sapply(names(domains), function(d) mean(boot_uj_ridge[[d]])),
    xgb_Uj   = sapply(names(domains), function(d) mean(boot_uj_xgb[[d]])))
  write.csv(importance_vs_uj, "importance_vs_Uj.csv", row.names = FALSE)  # save
} else {
  # Heavy analyses skipped: previous results are read from CSV
  cat("\n[RUN_OLD_HEAVY = FALSE] Reading previous results from CSV...\n")
  ridge_boot_summary <- read.csv("ridge_bootstrap_Uj.csv", check.names = FALSE)  # ridge bootstrap summary
  xgb_boot_summary   <- read.csv("xgb_bootstrap_Uj.csv",   check.names = FALSE)  # XGBoost bootstrap summary
  importance_vs_uj   <- read.csv("importance_vs_Uj.csv",   check.names = FALSE)  # importance vs U_j table
  importance_vs_uj <- importance_vs_uj[match(names(domains), importance_vs_uj$domain), ]  # align domain order
  stopifnot(!anyNA(importance_vs_uj$domain))                         # all domains must be found
}
