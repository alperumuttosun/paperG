# ---- 10. XGBoost sensitivity analizi ----
fit_predict_logloss_xgb <- function(cols, tr_idx, te_idx) {
  dtr <- xgb.DMatrix(data = X[tr_idx, cols, drop = FALSE], label = y[tr_idx])
  dte <- xgb.DMatrix(data = X[te_idx, cols, drop = FALSE], label = y[te_idx])
  fit <- xgb.train(
    params = list(objective = "binary:logistic", max_depth = 2, eta = 0.08,
                   subsample = 0.8, colsample_bytree = 0.8, lambda = 2, eval_metric = "logloss"),
    data = dtr, nrounds = 150, verbose = 0
  )
  logloss(y[te_idx], predict(fit, dte))
}

