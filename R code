# ---- 5. VIF ----
vif_manual <- function(Xs) {
  p <- ncol(Xs)
  vifs <- numeric(p)
  for (j in seq_len(p)) {
    fit <- lm(Xs[, j] ~ Xs[, -j])
    vifs[j] <- 1 / (1 - summary(fit)$r.squared)
  }
  names(vifs) <- colnames(Xs)
  sort(vifs, decreasing = TRUE)
}
vif_vals <- vif_manual(scale(X))
write.csv(data.frame(variable = names(vif_vals), VIF = vif_vals), "vif_table.csv", row.names = FALSE)
