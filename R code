# ================== NEW B) TUNED XGBoost BOOTSTRAP (long) ==================
if (RUN_XGB_TUNED) {
  xgb_grid <- expand.grid(max_depth = c(1, 2, 3), eta = c(0.05, 0.1))  # 6 hyperparameter combinations

  # Inside the training set: 5-fold CV picks max_depth, eta and number of rounds; returns OOB log-loss
  xgb_tuned_ll <- function(cols, tr_idx, te_idx) {
    dtr <- xgb.DMatrix(data = X[tr_idx, cols, drop = FALSE], label = y[tr_idx])  # training matrix
    best_ll <- Inf; best_prm <- NULL; best_nr <- NA                  # best CV result so far
    for (g in seq_len(nrow(xgb_grid))) {                             # loop over the grid
      prm <- list(objective = "binary:logistic", eval_metric = "logloss",
                  max_depth = xgb_grid$max_depth[g], eta = xgb_grid$eta[g],
                  subsample = 0.8, colsample_bytree = 0.8, lambda = 2, nthread = 2)  # parameters for this grid point
      cvr <- xgb.cv(params = prm, data = dtr, nrounds = 300, nfold = 5, verbose = FALSE)  # 5-fold CV
      el  <- as.data.frame(cvr$evaluation_log)                       # CV log-loss per round
      it  <- which.min(el$test_logloss_mean)                         # best number of rounds
      if (el$test_logloss_mean[it] < best_ll) { best_ll <- el$test_logloss_mean[it]; best_prm <- prm; best_nr <- it }  # keep the best
    }
    fit <- xgb.train(params = best_prm, data = dtr, nrounds = best_nr, verbose = 0)  # refit with the best setting
    dte <- xgb.DMatrix(data = X[te_idx, cols, drop = FALSE], label = y[te_idx])      # OOB test matrix
    logloss(y[te_idx], predict(fit, dte))                            # OOB log-loss
  }

  part_file <- "xgb_tuned_partial.rds"                               # checkpoint file (resume if interrupted)
  if (file.exists(part_file)) {                                      # an earlier partial run exists
    st <- readRDS(part_file); res_tuned <- st$res; b_start <- st$b + 1  # load progress
    cat("Resuming from:", b_start, "/", B_xgb_tuned, "\n")           # tell the user
  } else {
    res_tuned <- matrix(NA_real_, B_xgb_tuned, length(domains), dimnames = list(NULL, names(domains)))  # empty results
    b_start <- 1                                                     # start from the beginning
  }

  t0 <- Sys.time()                                                   # start time
  if (b_start <= B_xgb_tuned) for (bb in b_start:B_xgb_tuned) {      # bootstrap loop
    set.seed(5000 + bb)                                              # reproducible seed per replicate
    boot_idx <- sample(seq_len(n), n, replace = TRUE)                # bootstrap training sample
    oob_idx  <- setdiff(seq_len(n), unique(boot_idx))                # out-of-bag test patients
    if (length(oob_idx) < 15) next                                   # skip if OOB set is too small
    ll_full <- xgb_tuned_ll(all_feats, boot_idx, oob_idx)            # full-model tuned OOB loss
    for (d in names(domains))                                        # remove each domain and refit
      res_tuned[bb, d] <- xgb_tuned_ll(domain_reduced_cols[[d]], boot_idx, oob_idx) - ll_full  # U_j
    if (bb %% 10 == 0) {                                             # every 10 replicates
      saveRDS(list(res = res_tuned, b = bb), part_file)              # save a checkpoint
      cat("bootstrap", bb, "/", B_xgb_tuned, "-", round(difftime(Sys.time(), t0, units = "mins"), 1), "min\n")  # progress
    }
  }
  write.csv(res_tuned, "xgb_tuned_bootstrap_Uj.csv", row.names = FALSE)  # OUTPUT 3 (raw bootstrap values)
  xgb_tuned_summary <- do.call(rbind, lapply(names(domains), function(d) {
    v <- res_tuned[, d]; v <- v[!is.na(v)]                           # valid replicates only
    data.frame(domain = d, mean = mean(v), lo95 = unname(quantile(v, .025)),
               hi95 = unname(quantile(v, .975)), p_positive = mean(v > 0), n_boot = length(v))  # summary row
  }))
  write.csv(xgb_tuned_summary, "xgb_tuned_summary.csv", row.names = FALSE)  # OUTPUT 4 (summary)
  cat("\n--- Tuned XGBoost bootstrap summary ---\n"); print(xgb_tuned_summary[order(-xgb_tuned_summary$mean), ])  # show sorted
}

