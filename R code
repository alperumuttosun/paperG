# ---- 6. Domain-ici effective dimensionality (PCA-based) ----
effective_dim <- function(cols) {
  if (length(cols) == 1) return(1L)
  pc <- prcomp(scale(X[, cols]))
  cum_var <- cumsum(pc$sdev^2) / sum(pc$sdev^2)
  which(cum_var >= 0.95)[1]
}
